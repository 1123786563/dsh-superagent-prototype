{
  "name": "@local/dsh-issue-planner",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Plan one ready GitHub issue per polling cycle and hand it to an independent implementation agent.",
  "license": "MIT",
  "exports": { ".": "./index.js", "./client": "./client.js", "./settings": "./settings.js", "./settings/locale/*.json": "./settings/locale/*.json", "./settings/icon": "./icon.svg", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
  "files": ["*.js", "cordis.patch.yml", "prompts", "locale", "settings", "icon.svg", "README.md", "VERIFICATION.md"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" }, "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-locale"] } },
  "engines": { "node": ">=22.19.0", "dsh": "^0.2.1-alpha.2" },
  "dependencies": { "proper-lockfile": "4.1.2" },
  "peerDependencies": { "@deepseek-ai/schemastery": "3.18.5-alpha.1" },
  "devDependencies": { "jsdom": "29.1.1", "react": "18.3.1", "react-dom": "18.3.1" },
  "scripts": { "test": "node --test tests/*.node.js" }
}
